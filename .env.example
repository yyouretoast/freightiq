# ==============================================================================
# FreightIQ Environment Configuration Template
# ==============================================================================

# LLM Provider Configuration
# Supported options: groq (default), gemini, openai, anthropic, ollama
LLM_PROVIDER=groq

# Primary / Default Provider: Groq
GROQ_API_KEY=your_groq_api_key_here
# AGENT_MODEL=qwen/qwen3.8-27b

# Alternative Providers (Optional)
# GOOGLE_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434/v1

# FMCSA QCMobile Web API Key (Optional override; defaults to public demo key)
# FMCSA_WEB_KEY=4f03a62f4fb2a690e0e01da1eef67664c39846b0

# Freight Market Web Search (Tavily API; falls back to DuckDuckGo if omitted)
TAVILY_API_KEY=your_tavily_api_key_here

# Observability & Tracing (LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=FreightIQ-Agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
