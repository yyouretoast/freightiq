# Core Groq LLM API Key (Required for cloud inference)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override agent model (default: qwen/qwen3.8-27b)
# AGENT_MODEL=qwen/qwen3.8-27b

# Optional: Tavily Search API Key (for real-time market spot rates; falls back to DuckDuckGo if unset)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Enable LangSmith Observability Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=FreightIQ-Agent
LANGCHAIN_ENDPOINT=https://aws.api.smith.langchain.com
