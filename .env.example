# FreightIQ Environment Configuration Template
# Copy this file to .env and populate your active credentials:
# cp .env.example .env

# LLM Provider Configuration ('groq', 'openai', 'ollama')
LLM_PROVIDER=groq

# Primary Model Identifier
AGENT_MODEL=qwen/qwen3.8-27b

# Maximum Output Tokens Cap (Default 950 for Groq free-tier OTPM quota)
MAX_OUTPUT_TOKENS=950

# Provider API Keys
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# External Search & Intelligence APIs
# Optional: Live freight market intelligence (falls back to DuckDuckGo if omitted)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Live FMCSA QCMobile REST API key (falls back to internal DB if omitted)
FMCSA_WEB_KEY=your_fmcsa_web_key_here

# Optional: LangSmith Observability & Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=FreightIQ-Agent
