# ==============================================================================
# FreightIQ Environment Configuration Template
# ==============================================================================

# LLM Provider Configuration
# Supported options: groq (default), openai, ollama
LLM_PROVIDER=groq

# Primary / Default Provider: Groq
GROQ_API_KEY=your_groq_api_key_here
# AGENT_MODEL=qwen/qwen3.8-27b
# MAX_OUTPUT_TOKENS=950

# Alternative Providers (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434/v1

# FMCSA QCMobile Web API Key (Optional; falls back to internal verified DB if omitted)
# FMCSA_WEB_KEY=your_fmcsa_web_key_here

# Freight Market Web Search (Tavily API; falls back to DuckDuckGo if omitted)
TAVILY_API_KEY=your_tavily_api_key_here

# Observability & Tracing (LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=FreightIQ-Agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
